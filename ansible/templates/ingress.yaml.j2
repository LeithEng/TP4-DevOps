apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: mon-app-devops-ingress
  namespace: {{ k8s_namespace }}
  annotations:
    nginx.ingress.kubernetes.io/rewrite-target: /
spec:
  rules:
    - host: mon-app.local
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: mon-app-devops-svc
                port:
                  number: 80