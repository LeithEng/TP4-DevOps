			"targets": [
				{
					"editorMode": "code",
					"expr": "kube_deployment_status_replicas_available{namespace=\"$namespace\", deployment=\"mon-app-devops\"} / kube_deployment_spec_replicas{namespace=\"$namespace\", deployment=\"mon-app-devops\"}",
